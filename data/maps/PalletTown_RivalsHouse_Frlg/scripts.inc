	.string "groom an EGG.$"

PalletTown_RivalsHouse_Text_MayISeeFirstMon::
	.string "DAISY: Your POKéMON grow to love\n"
	.string "you if you raise them with love.\p"
	.string "For example, {PLAYER}, may I see\n"
	.string "your first POKéMON?$"

